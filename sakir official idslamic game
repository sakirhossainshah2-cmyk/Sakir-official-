<div id="result">
    Score: 0 | Time: 30
</div>

<button onclick="startGame()">START GAME</button>

<div id="game">
    <div id="target" onclick="hitTarget()"></div>
</div>

<script>

let score = 0;
let time = 30;
let timer;
let playing = false;

const target = document.getElementById("target");
const game = document.getElementById("game");
const result = document.getElementById("result");

function startGame() {

    score = 0;
    time = 30;
    playing = true;

    target.style.display = "block";

    moveTarget();

    clearInterval(timer);

    timer = setInterval(function() {

        time--;

        result.innerHTML =
            "Score: " + score + " | Time: " + time;

        if (time <= 0) {
            endGame();
        }

    }, 1000);
}

function moveTarget() {

    if (!playing) return;

    let maxX = game.clientWidth - target.offsetWidth;
    let maxY = game.clientHeight - target.offsetHeight;

    let x = Math.random() * maxX;
    let y = Math.random() * maxY;

    target.style.left = x + "px";
    target.style.top = y + "px";
}

function hitTarget() {

    if (!playing) return;

    score++;

    result.innerHTML =
        "Score: " + score + " | Time: " + time;

    moveTarget();
}
